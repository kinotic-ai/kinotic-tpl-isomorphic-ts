import { existsSync, readdirSync, readFileSync } from 'node:fs'
import { join } from 'node:path'
import { defineWorkspace } from 'bunup'
import { exports } from 'bunup/plugins'

// https://bunup.dev/docs/guide/workspaces
// The workspace packages of {{ projectName }}: the domain package, then every microservice found
// under packages/microservices, so a new microservice needs no entry here

const MICROSERVICES_DIR = 'packages/microservices'

// Each directory directly under packages/microservices with a package.json is a microservice. Its
// entry is the package.json "main", or src/main.ts when it declares none, as the deployment resolves it.
function microservices() {
	const dirs = existsSync(MICROSERVICES_DIR)
		? readdirSync(MICROSERVICES_DIR, { withFileTypes: true }).filter(d => d.isDirectory())
		: []
	return dirs
		.map(d => join(MICROSERVICES_DIR, d.name))
		.filter(root => existsSync(join(root, 'package.json')))
		.map(root => {
			const manifest = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'))
			const main = typeof manifest.main === 'string' && manifest.main.trim() !== '' ? manifest.main : 'src/main.ts'
			return {
				name: root.slice(MICROSERVICES_DIR.length + 1),
				root,
				config: { entry: main.replace(/^\.\//, ''), dts: false }
			}
		})
}

export default defineWorkspace([
	{
		name: 'domain',
		root: 'packages/domain',
		config: {
			plugins: [
				// The exports plugin keeps package.json exports in sync with the build.
				// Its auto-generated "." entry lists the dist targets first, and export
				// condition matching is first-match-wins — the bun runtime would then
				// always load dist instead of source. So "." is excluded from generation
				// and spelled out here with the source conditions (development, bun)
				// ahead of the dist fallbacks used by registry consumers.
				exports({
					exclude: ['.'],
					customExports: () => ({
						'.': {
							development: './index.ts',
							bun: './index.ts',
							types: './dist/index.d.ts',
							default: './dist/index.js'
						}
					})
				})
			]
		}
	},
	...microservices()
])
