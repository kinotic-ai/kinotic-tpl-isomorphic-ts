{
    "name": "{{ projectSlug }}",
    "private": true,
    "scripts": {
        "build": "bunup",
        "dev": "bunup --watch",
        "generate": "kinotic generate",
        "type-check": "bun run --filter '*' type-check"
    },
    "devDependencies": {
        "@kinotic-ai/kinotic-cli": "{{ kinoticCliVersion | remove_first: "^" }}",
        "@kinotic-ai/management-api": "{{ kinoticManagementApiVersion | remove_first: "^" }}",
        "@types/bun": "^1.3.10",
        "bunup": "^0.16.31",
        "typescript": "^5.9.3"
    },
    "catalog": {
        "@kinotic-ai/core": "{{ kinoticCoreVersion | remove_first: "^" }}",
        "@kinotic-ai/management-api": "{{ kinoticManagementApiVersion | remove_first: "^" }}",
        "@kinotic-ai/persistence": "{{ kinoticPersistenceVersion | remove_first: "^" }}"
    },
    "workspaces": [
        "packages/*",
        "packages/microservices/*",
        "packages/ui/*"
    ],
    "type": "module"
}
